# Режим LLM: extractive (без API) | openai | yandex
LLM_MODE=extractive

# OpenAI (опционально)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# YandexGPT (опционально)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite

# Telegram (для тарифа Про / опционально)
TELEGRAM_BOT_TOKEN=

# Пути
KNOWLEDGE_BASE_DIR=knowledge_base
INDEX_DIR=index
INCOMING_DIR=data/incoming
LOGS_DIR=logs

# Эмбеддинги
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Защита
ENABLE_INJECTION_FILTER=true
ENABLE_SECURITY_PREPROMPT=true
